# OS / editor cruft
.DS_Store
.Rhistory
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/
venv/
.venv/
env/

# Secrets
.env
*.env

# Data, models, logs, and reports are regenerated by the pipeline —
# keep directory placeholders (.gitkeep) but not their contents.
data/**
!data/**/
!data/**/.gitkeep

models/**
!models/**/
!models/**/.gitkeep

logs/**
!logs/**/
!logs/**/.gitkeep
