# OS / editor cruft
.DS_Store
**/.DS_Store
.Rhistory
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# Secrets
.env
*.env

# Pipeline-generated data/models/logs -- keep directory placeholders
# (.gitkeep) but not their contents.
data/**
!data/**/
!data/**/.gitkeep

models/**
!models/**/
!models/**/.gitkeep

logs/**
!logs/**/
!logs/**/.gitkeep

# Pipeline-generated reports -- except the legacy-replication figures,
# which are committed as a historical reference (original project run).
reports/**
!reports/**/
!reports/**/.gitkeep
!reports/legacy_replication/**

# Legacy large-universe replication mode: user-supplied price CSVs, not
# included in this repo (see construction.legacy_replication in config.yaml)
data/replication_raw/

# MLflow
mlruns/
mlartifacts/

# DVC
.dvc/cache
.dvc/tmp

# Airflow
airflow/logs/
airflow.db
airflow-webserver.pid
.coverage
htmlcov/
