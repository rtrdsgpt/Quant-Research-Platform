# OS / editor cruft
.DS_Store
**/.DS_Store
.Rhistory
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Secrets
.env
*.env

# data/raw, data/features, data/processed are DVC-tracked (see *.dvc
# files + data/.gitignore, generated by `dvc add`) rather than git-ignored
# outright -- DVC manages ignoring their actual contents.

models/**
!models/**/
!models/**/.gitkeep

logs/**
!logs/**/
!logs/**/.gitkeep

# Pipeline-generated reports -- except the legacy-replication figures,
# which are committed as a historical reference (original project run).
reports/**
!reports/**/
!reports/**/.gitkeep
!reports/legacy_replication/**

# Legacy large-universe replication mode: user-supplied price CSVs, not
# included in this repo (see construction.legacy_replication in config.yaml)
data/replication_raw/

# MLflow
mlruns/
mlartifacts/
mlflow.db

# DVC
.dvc/cache
.dvc/tmp

# Airflow
airflow/logs/
airflow.db
airflow-webserver.pid
.coverage
htmlcov/
